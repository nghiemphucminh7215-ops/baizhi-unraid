# 复制为 .env 并设置 chmod 600 .env；请勿上传真实密码。
# 默认仅本机可访问；局域网访问时改为 NAS 的实际内网 IP。
MONKEYAI_BIND_IP=127.0.0.1
MONKEYAI_ADMIN_PORT=8088
# 必须与客户端实际访问的根地址一致；生产环境请使用 HTTPS 反向代理。
MONKEYAI_PUBLIC_URL=http://127.0.0.1:8088
# 用 openssl rand -hex 32 分别生成不同的随机值，不要复用密码。
# 数据库密码进入连接 URI，必须使用十六进制值，避免 URI 保留字符。
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
MONKEYAI_INITIAL_ADMIN_EMAIL=
# 首次启动必填强随机密码；成功登录后修改密码，删除此行并重建 backend。
MONKEYAI_INITIAL_ADMIN_PASSWORD=
# 仅在配置反向代理时填写直接相连的可信代理 IP/CIDR。
MONKEYAI_TRUSTED_PROXY_CIDRS=
